# Development defaults — copy to .env and adjust values.

NODE_ENV=development
DATABASE_URL="postgresql://postgres:0000@localhost:5432/ecommerce_db?schema=public"
JWT_SECRET="change_me_change_me_change_me_change_me"
PORT=4000

# Comma-separated allowed frontend origins (no trailing slash)
# Production: your exact Vercel URL only (comma-separated for previews)
# CORS_ORIGIN="https://e-commerce-website-sigma-lake.vercel.app"
CORS_ORIGIN="http://localhost:5173"

COOKIE_NAME="access_token"
REFRESH_COOKIE_NAME="refresh_token"
CSRF_COOKIE_NAME="csrf_token"
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# Set to true when running behind nginx, Railway, Render, etc.
TRUST_PROXY=false

# Request body size limit (JSON / urlencoded)
JSON_BODY_LIMIT="100kb"

# Rate limiting (per IP, per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=30

# --- Production checklist ---
# NODE_ENV=production
# JWT_SECRET=<random 32+ chars>
# CORS_ORIGIN="https://your-frontend.example.com"
# COOKIE_SECURE=true
# COOKIE_SAMESITE="lax"
# TRUST_PROXY=true
